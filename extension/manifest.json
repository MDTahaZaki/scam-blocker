{
  "manifest_version": 3,
  "name": "Scam Link Detector",
  "version": "1.0.0",
  "description": "Detects and blocks scam/phishing links using a synced blocklist and heuristic rules.",
  "permissions": ["webNavigation", "storage", "tabs", "activeTab", "scripting", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*", "https://*.firebaseio.com/*", "https://*.googleapis.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' https://www.gstatic.com; object-src 'self'"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Scam Link Detector"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["utils/heuristics.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blockpage/block.html", "blockpage/block.css", "blockpage/block.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
