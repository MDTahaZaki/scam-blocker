# Copy this file to .env in backend/functions/ for local emulator use.
# These functions use the default Firebase Admin credentials and Firestore,
# so no secrets are strictly required — this file is provided for any
# project-specific overrides you may want to add later.

# Firebase project id (only needed if running commands outside `firebase use`)
FIREBASE_PROJECT_ID=your-project-id

# Minimum number of distinct reporters before a URL is auto-blocklisted
REPORT_THRESHOLD=3
