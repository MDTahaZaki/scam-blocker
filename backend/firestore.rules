rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Reported URLs: no direct client access at all, not even read. All
    // reads/writes go through Cloud Functions (reportUrl), which use the
    // Admin SDK and bypass these rules entirely. Revisit this if/when the
    // dashboard needs its own authenticated read access to this collection
    // (e.g. via a dedicated getRecentReports callable).
    match /reported_urls/{reportId} {
      allow read: if false;
      allow write: if false;
    }

    // Blocklist: public read so the extension (which has no signed-in user)
    // can sync it. Writes only ever happen via the reportUrl Cloud Function
    // (Admin SDK), so direct client writes are always denied.
    match /blocklist/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Aggregate scan/block/report counters used by the dashboard (a single
    // `stats/global` document: totalScans, totalBlocked, totalReported).
    // Public read, written only by the incrementScan Cloud Function.
    match /stats/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
