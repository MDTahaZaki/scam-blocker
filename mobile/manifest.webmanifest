{
  "name": "SafeLink AI – Scam Detector",
  "short_name": "SafeLink",
  "description": "Paste or share a link to check it for scam/phishing signals, backed by the same detection engine as the Scam Link Detector browser extension.",
  "start_url": "/mobile/index.html",
  "scope": "/mobile/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#d32f2f",
  "orientation": "portrait",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/mobile/index.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
